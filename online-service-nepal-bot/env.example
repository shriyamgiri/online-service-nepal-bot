# ==============================
# Online Service Nepal Bot — .env
# ==============================

# From Meta Developer Console → Your App → Messenger → Generate Token
PAGE_ACCESS_TOKEN=your_page_access_token_here

# Your FB Page-Scoped User ID (message yourself from the Page to get it)
ADMIN_ID=your_admin_psid_here

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Your Lovable website URL (no trailing slash)
# Example: https://my-shop.lovable.app
WEBSITE_URL=https://your-lovable-site.com

# Server port (Render/Railway/Heroku sets this automatically)
PORT=3000
